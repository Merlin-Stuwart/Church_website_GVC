# Grace Victory Church (GVC) Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=grace_victory_church

# Church Details
CHURCH_NAME=Grace Victory Church
CHURCH_EMAIL=contact@gracevictorychurch.org
CHURCH_PHONE=+91 93605 88397
CHURCH_ADDRESS=Grace Victory Church, Vattamalai, Tamil Nadu, India

# Admin Security & Token Signing Secret
AUTH_SECRET_KEY=change_this_to_a_random_long_secret_key_in_production
ADMIN_USER_ID=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_NOTIFICATION_EMAIL=contact@gracevictorychurch.org

# Razorpay Online Payment Gateway (Optional - for live UPI/card payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP Email Configuration (Optional - for automated email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=notifications@gracevictorychurch.org
